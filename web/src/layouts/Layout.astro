---
import { modules } from '../data/curriculum';

interface Props {
  title: string;
  description?: string;
  activeModuleId?: number;
  canonical?: string;
}

const { title, description, activeModuleId, canonical } = Astro.props;
const base = import.meta.env.BASE_URL;
const siteUrl = 'https://drmurataltun.github.io/llm-bootcamp';

// Title 50-60 kar hedefi: ana sayfa kısa, modül sayfaları zaten içerikli
const metaTitle = title.includes('Modül')
  ? `${title} · Dr. Murat Altun`            // Modül sayfaları (zaten uzun başlık)
  : `LLM Tabanlı Uygulama Geliştirme · Dr. Murat Altun`;  // Ana sayfa, eğitmen
const metaDesc = description ?? 'BTK Akademi · 42 saatlik ileri seviye LLM atölyesi · RAG, fine-tuning, Hugging Face, Ollama, LangChain, FastAPI, Docker · Temmuz 2026.';
const canonicalUrl = canonical ?? siteUrl;

// SEO için 4 JSON-LD: Course + EducationalOrganization + Person + WebSite
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Course',
    name: 'LLM Tabanlı Uygulama Geliştirme Atölyesi — 42 saat · 6 modül',
    description: metaDesc,
    provider: {
      '@type': 'Person',
      name: 'Dr. Murat Altun',
      url: 'https://github.com/DrMuratAltun',
      sameAs: [
        'https://drmurataltun.github.io/',
        'https://drmurataltun.github.io/deep-learning-bootcamp/',
        'https://drmurataltun.github.io/computer-vision-bootcamp/',
        'https://drmurataltun.github.io/VB-YZ-90/',
        'https://yapayzekaokulum.com',
      ],
    },
    educationalLevel: 'Advanced',
    inLanguage: 'tr',
    numberOfCredits: 42,
    courseMode: 'online',
    url: siteUrl,
    isPartOf: {
      '@type': 'Course',
      name: 'Dr. Murat Altun Bootcamp Serisi',
      url: 'https://drmurataltun.github.io/',
    },
    hasCourseInstance: {
      '@type': 'CourseInstance',
      courseMode: 'online',
      courseWorkload: 'PT42H',
      inLanguage: 'tr',
    },
    teaches: [
      'ML model deployment (FastAPI, Docker)',
      'Hugging Face ekosistemi (Hub, Transformers, Datasets, Spaces)',
      'Lokal LLM çalıştırma (Ollama, LM Studio, GGUF, llama.cpp)',
      'RAG mimarisi (LangChain, LangGraph, ChromaDB, RAGAS)',
      'Fine-tuning (LoRA, QLoRA, Unsloth, Axolotl)',
      'GenAI DevOps (Google AI Studio, Antigravity)',
      'Prompt engineering ve prompt injection savunması',
      'Output guardrails ve PII filtering',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'EducationalOrganization',
    name: 'Dr. Murat Altun · LLM Tabanlı Uygulama Geliştirme Atölyesi',
    url: siteUrl,
    logo: `${siteUrl}/favicon.svg`,
    sameAs: [
      'https://drmurataltun.github.io/',
      'https://drmurataltun.github.io/deep-learning-bootcamp/',
      'https://drmurataltun.github.io/computer-vision-bootcamp/',
      'https://drmurataltun.github.io/VB-YZ-90/',
      'https://yapayzekaokulum.com',
      'https://gencyz.com',
      'https://yz-araclari.com',
      'https://akademikyz.com',
      'https://www.linkedin.com/in/drmurataltun',
      'https://github.com/DrMuratAltun',
    ],
    description: 'Türkçe, ileri seviye, uygulamalı LLM tabanlı uygulama geliştirme eğitim platformu. RAG, fine-tuning, Hugging Face, Ollama, LangChain.',
    founder: {
      '@type': 'Person',
      name: 'Dr. Murat Altun',
    },
    contactPoint: {
      '@type': 'ContactPoint',
      telephone: '+90-539-257-82-06',
      contactType: 'Customer Service',
      areaServed: 'TR',
      availableLanguage: ['Turkish', 'English'],
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Dr. Murat Altun',
    url: 'https://drmurataltun.github.io/',
    image: `${siteUrl}/img/dr-murat-altun.png`,
    jobTitle: 'Yapay Zekâ Uzmanı ve Eğitmeni, Bilişim Teknolojileri Öğretmeni',
    description: 'Yapay zeka eğitmeni, MEB resmi ders kitabı yazarı, TÜBİTAK danışmanı. LLM, RAG, fine-tuning, Hugging Face ve üretken yapay zeka uzmanı.',
    knowsAbout: [
      'Büyük Dil Modelleri', 'Large Language Models', 'LLM',
      'Retrieval-Augmented Generation', 'RAG',
      'Hugging Face Transformers', 'Datasets', 'Spaces',
      'LangChain', 'LangGraph', 'ChromaDB', 'Qdrant',
      'PEFT', 'LoRA', 'QLoRA', 'Unsloth', 'Axolotl',
      'Ollama', 'LM Studio', 'llama.cpp', 'GGUF',
      'FastAPI', 'Docker', 'MLOps',
      'Google AI Studio', 'Antigravity',
      'Prompt Engineering', 'Prompt Injection Defense',
      'Yapay Zekâ', 'Makine Öğrenmesi', 'Derin Öğrenme',
    ],
    sameAs: [
      'https://drmurataltun.github.io/',
      'https://drmurataltun.github.io/deep-learning-bootcamp/',
      'https://drmurataltun.github.io/computer-vision-bootcamp/',
      'https://drmurataltun.github.io/VB-YZ-90/',
      'https://yapayzekaokulum.com',
      'https://www.linkedin.com/in/drmurataltun',
      'https://github.com/DrMuratAltun',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'LLM Tabanlı Uygulama Geliştirme Atölyesi',
    url: siteUrl,
    inLanguage: 'tr',
    author: { '@type': 'Person', name: 'Dr. Murat Altun' },
    publisher: { '@type': 'Person', name: 'Dr. Murat Altun' },
  },
];
---

<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#6D28D9" />

  <!-- Favicons -->
  <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  <link rel="apple-touch-icon" href={`${base}favicon.svg`} />

  <!-- Primary Meta -->
  <title>{metaTitle}</title>
  <meta name="description" content={metaDesc} />
  <meta name="author" content="Dr. Murat Altun" />
  <meta name="keywords" content="llm, büyük dil modelleri, large language models, RAG, retrieval augmented generation, fine-tuning, LoRA, QLoRA, unsloth, axolotl, hugging face, ollama, lm studio, llama.cpp, langchain, langgraph, chromadb, ragas, prompt engineering, prompt injection, BTK Akademi, Dr. Murat Altun, online kurs, Türkçe, FastAPI, Docker" />
  <link rel="canonical" href={canonicalUrl} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:title" content={metaTitle} />
  <meta property="og:description" content={metaDesc} />
  <meta property="og:locale" content="tr_TR" />
  <meta property="og:site_name" content="LLM Tabanlı Uygulama Geliştirme Atölyesi" />
  <meta property="og:image" content={`${siteUrl}/og-image.jpg`} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="LLM Tabanlı Uygulama Geliştirme Atölyesi — 42 saat, BTK Akademi, Dr. Murat Altun" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={metaTitle} />
  <meta name="twitter:description" content={metaDesc} />
  <meta name="twitter:image" content={`${siteUrl}/og-image.jpg`} />
  <meta name="twitter:image:alt" content="LLM Tabanlı Uygulama Geliştirme Atölyesi — Dr. Murat Altun" />

  <!-- Robots -->
  <meta name="robots" content="index, follow" />

  <!-- JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <style>
    body { font-family: 'Inter', sans-serif; }
    h1, h2, h3 { font-family: 'Georgia', 'Times New Roman', serif; }
  </style>
</head>
<body class="bg-cream min-h-screen">

  <!-- TOP HEADER -->
  <header class="bg-dark text-white shadow-lg sticky top-0 z-50">
    <div class="max-w-screen-xl mx-auto px-4 py-3 flex items-center justify-between">
      <a href={base} class="flex items-center gap-3 hover:opacity-90 transition-opacity">
        <div class="w-9 h-9 rounded-lg bg-gradient-to-br from-primary via-secondary to-accent flex items-center justify-center text-white font-bold text-sm">LLM</div>
        <div>
          <div class="font-semibold text-sm leading-tight">LLM Tabanlı Uygulama Geliştirme Atölyesi</div>
          <div class="text-xs text-gray-400">BTK Akademi · 42 Saat · 6 Modül · Dr. Murat Altun</div>
        </div>
      </a>
      <div class="hidden md:flex items-center gap-2 text-xs">
        <span class="px-2 py-1 rounded bg-primary/25 text-purple-200 border border-primary/40">Temel (M1-2)</span>
        <span class="px-2 py-1 rounded bg-secondary/25 text-pink-200 border border-secondary/40">RAG (M3-4)</span>
        <span class="px-2 py-1 rounded bg-accent/25 text-emerald-200 border border-accent/40">Fine-tune & DevOps (M5-6)</span>
        <a href={`${base}egitmen`} class="px-2 py-1 rounded bg-white/10 text-gray-300 border border-white/20 hover:text-white hover:border-white/40 transition-colors">👨‍🏫 Eğitmen</a>
      </div>
    </div>
  </header>

  <div class="flex max-w-screen-xl mx-auto">

    <!-- SIDEBAR -->
    <aside class="w-64 shrink-0 hidden lg:block sticky top-[57px] self-start h-[calc(100vh-57px)] overflow-y-auto border-r border-border bg-warmBg">
      <nav class="py-4" aria-label="Modül navigasyonu">
        <a href={base} class={`flex items-center gap-2 px-4 py-2 text-sm font-medium transition-colors ${!activeModuleId ? 'bg-primary text-white' : 'text-mid hover:text-primary hover:bg-border/50'}`}>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
          Program Özeti
        </a>
        <a href={`${base}egitmen`} class="flex items-center gap-2 px-4 py-2 text-sm font-medium transition-colors text-mid hover:text-secondary hover:bg-border/50">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
          Eğitmen Hakkında
        </a>

        <!-- TEMEL -->
        <div class="px-4 pt-4 pb-1">
          <span class="text-[10px] font-bold uppercase tracking-widest text-primary">Bölüm A — Temel</span>
        </div>
        {modules.filter(m => m.section === 'TEMEL').map(m => (
          <a
            href={`${base}modul/${m.slug}`}
            aria-current={activeModuleId === m.id ? 'page' : undefined}
            class={`flex items-center gap-2 px-4 py-2 text-sm transition-colors ${activeModuleId === m.id ? 'bg-primary text-white font-semibold' : 'text-mid hover:text-primary hover:bg-border/50'}`}
          >
            <span class={`w-6 h-6 rounded-full flex items-center justify-center text-xs shrink-0 ${activeModuleId === m.id ? 'bg-white/20' : 'bg-primary/10 text-primary'}`}>{m.id}</span>
            <span class="truncate leading-snug">{m.title.split('—')[0].trim().split(' ').slice(0,3).join(' ')}</span>
          </a>
        ))}

        <!-- EKOSISTEM + RAG -->
        <div class="px-4 pt-4 pb-1">
          <span class="text-[10px] font-bold uppercase tracking-widest text-secondary">Bölüm B — Ekosistem & RAG</span>
        </div>
        {modules.filter(m => m.section === 'EKOSISTEM' || m.section === 'RAG').map(m => (
          <a
            href={`${base}modul/${m.slug}`}
            aria-current={activeModuleId === m.id ? 'page' : undefined}
            class={`flex items-center gap-2 px-4 py-2 text-sm transition-colors ${activeModuleId === m.id ? 'bg-secondary text-white font-semibold' : 'text-mid hover:text-secondary hover:bg-border/50'}`}
          >
            <span class={`w-6 h-6 rounded-full flex items-center justify-center text-xs shrink-0 ${activeModuleId === m.id ? 'bg-white/20' : 'bg-secondary/10 text-secondary'}`}>{m.id}</span>
            <span class="truncate leading-snug">{m.title.split('—')[0].trim().split(' ').slice(0,3).join(' ')}</span>
          </a>
        ))}

        <!-- FINE-TUNING + DEVOPS -->
        <div class="px-4 pt-4 pb-1">
          <span class="text-[10px] font-bold uppercase tracking-widest text-accent">Bölüm C — Fine-tune & DevOps</span>
        </div>
        {modules.filter(m => m.section === 'FINE-TUNING' || m.section === 'DEVOPS').map(m => (
          <a
            href={`${base}modul/${m.slug}`}
            aria-current={activeModuleId === m.id ? 'page' : undefined}
            class={`flex items-center gap-2 px-4 py-2 text-sm transition-colors ${activeModuleId === m.id ? 'bg-accent text-white font-semibold' : 'text-mid hover:text-accent hover:bg-border/50'}`}
          >
            <span class={`w-6 h-6 rounded-full flex items-center justify-center text-xs shrink-0 ${activeModuleId === m.id ? 'bg-white/20' : 'bg-accent/10 text-accent'}`}>{m.id}</span>
            <span class="truncate leading-snug">{m.title.split('—')[0].trim().split(' ').slice(0,3).join(' ')}</span>
          </a>
        ))}
      </nav>
    </aside>

    <!-- MAIN CONTENT -->
    <main class="flex-1 min-w-0 p-6">
      <slot />
    </main>

  </div>

  <!-- FOOTER with Cross-Links -->
  <footer class="bg-dark text-gray-400 mt-12 border-t-4 border-secondary">
    <div class="max-w-screen-xl mx-auto px-6 py-10">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">

        <!-- Hakkında -->
        <div>
          <h3 class="text-white font-semibold text-sm mb-3">LLM Tabanlı Uygulama Geliştirme Atölyesi</h3>
          <p class="text-xs leading-relaxed">
            Dr. Murat Altun tarafından BTK Akademi bünyesinde verilen 42 saatlik ileri seviye atölye.
            Model deployment, Hugging Face ekosistemi, lokal LLM çalıştırma (Ollama, LM Studio),
            production-grade RAG mimarisi (LangChain, LangGraph, RAGAS),
            PEFT/LoRA fine-tuning (Unsloth, Axolotl) ve GenAI DevOps konularını
            uçtan uca uygulamalı olarak işler.
          </p>
        </div>

        <!-- Dr. Murat Altun Projeleri (SEO Cross-Links) -->
        <div>
          <h3 class="text-white font-semibold text-sm mb-3">Dr. Murat Altun — Diğer Bootcamp'ler & Projeler</h3>
          <ul class="space-y-2 text-xs">
            <li>
              <a href="https://drmurataltun.github.io/computer-vision-bootcamp/" target="_blank" rel="noopener" class="hover:text-secondary transition-colors">
                📷 Bilgisayarlı Görü Bootcamp — OpenCV + PyTorch (90 saat)
              </a>
            </li>
            <li>
              <a href="https://drmurataltun.github.io/deep-learning-bootcamp/" target="_blank" rel="noopener" class="hover:text-secondary transition-colors">
                🧠 Derin Öğrenme Bootcamp — Keras 3 ile 90 saat
              </a>
            </li>
            <li>
              <a href="https://drmurataltun.github.io/VB-YZ-90/" target="_blank" rel="noopener" class="hover:text-secondary transition-colors">
                📊 VB-YZ-90 — Veri Bilimi & YZ Uzmanlığı (90 saat)
              </a>
            </li>
            <li>
              <a href="https://yapayzekaokulum.com" target="_blank" rel="noopener" class="hover:text-secondary transition-colors">
                🎓 Yapay Zeka Okulum — Eğitimciler için YZ eğitim platformu
              </a>
            </li>
            <li>
              <a href="https://gencyz.com" target="_blank" rel="noopener" class="hover:text-accent transition-colors">
                🧒 GençYZ — Çocuklar için yapay zeka eğitimi
              </a>
            </li>
            <li>
              <a href="https://yz-araclari.com" target="_blank" rel="noopener" class="hover:text-secondary transition-colors">
                🛠️ YZ Araçları — Yapay zeka araçları rehberi
              </a>
            </li>
            <li>
              <a href="https://akademikyz.com" target="_blank" rel="noopener" class="hover:text-accent transition-colors">
                📚 ScholarAI — Akademik araştırma asistanı
              </a>
            </li>
            <li>
              <a href="https://drmurataltun.github.io" target="_blank" rel="noopener" class="hover:text-secondary transition-colors">
                👤 Dr. Murat Altun — Kişisel web sitesi
              </a>
            </li>
          </ul>
        </div>

        <!-- Program & İletişim -->
        <div>
          <h3 class="text-white font-semibold text-sm mb-3">Program & İletişim</h3>
          <ul class="space-y-2 text-xs">
            <li>📅 6 Gün · 42 Saat · 6 Modül</li>
            <li>🚀 FastAPI · Docker · Hugging Face</li>
            <li>🦙 Ollama · LM Studio · llama.cpp · GGUF</li>
            <li>🔍 LangChain · LangGraph · ChromaDB · RAGAS</li>
            <li>🧪 PEFT · LoRA · QLoRA · Unsloth · Axolotl</li>
            <li>🛡️ Guardrails · PII filtering · Prompt injection defense</li>
            <li>☁️ Google AI Studio · Antigravity</li>
          </ul>

          <!-- Kurumsal Eğitim CTA -->
          <div class="mt-5 rounded-lg bg-secondary/15 border border-secondary/30 p-3">
            <p class="text-[11px] font-semibold text-secondary uppercase tracking-wider mb-1">Kurumsal Eğitim</p>
            <p class="text-xs text-gray-300 leading-relaxed mb-2">
              Şirket içi, üniversite ve kamu kurumlarına özel LLM, RAG ve Fine-tuning atölyeleri.
            </p>
            <a href="https://wa.me/905077501982?text=Kurumsal%20LLM%20Tabanl%C4%B1%20Uygulama%20Geli%C5%9Ftirme%20At%C3%B6lyesi%20hakk%C4%B1nda%20bilgi%20almak%20istiyorum." target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 text-xs font-semibold text-white bg-[#25D366] hover:bg-[#1ebe57] rounded px-3 py-1.5 transition-colors">
              <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
              0507 750 19 82
            </a>
            <a href="https://t.me/yapayzekaokulum" target="_blank" rel="noopener" class="mt-2 inline-flex items-center gap-1.5 text-xs font-semibold text-white bg-[#229ED9] hover:bg-[#1c8ec2] rounded px-3 py-1.5 transition-colors">
              <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.464.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
              Telegram
            </a>
          </div>

