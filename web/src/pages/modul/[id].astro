---
import Layout from '../../layouts/Layout.astro';
import { modules, getModuleBySlug } from '../../data/curriculum';

export function getStaticPaths() {
  return modules.map(m => ({ params: { id: m.slug } }));
}

const { id } = Astro.params;
const mod = getModuleBySlug(id!);
if (!mod) return Astro.redirect('/');

const base = import.meta.env.BASE_URL;
const driveId = mod.pptxDriveId;
const SITE_ORIGIN = 'https://drmurataltun.github.io';
const pptxPublicUrl = `${SITE_ORIGIN}${base}sunumlar/${mod.pptxFile}`;
// Drive ID varsa Drive embed; yoksa Office Online viewer ile public PPTX'i göster
const pptxEmbedUrl = driveId
  ? `https://drive.google.com/file/d/${driveId}/preview`
  : `https://view.officeapps.live.com/op/embed.aspx?src=${encodeURIComponent(pptxPublicUrl)}`;

const prevModule = modules.find(m => m.id === mod.id - 1);
const nextModule = modules.find(m => m.id === mod.id + 1);

const sectionColorClass: Record<string, string> = {
  'TEMEL':       'bg-primary',
  'EKOSISTEM':   'bg-secondary',
  'RAG':         'bg-secondary',
  'FINE-TUNING': 'bg-accent',
  'DEVOPS':      'bg-accent',
};
const badgeBg = sectionColorClass[mod.section] ?? 'bg-mid';

const WHATSAPP_MESSAGE = 'Dr. Murat ALTUN BTK Akademi LLM Tabanlı Uygulama Geliştirme Atölyesi (6-17 Temmuz 2026) hakkında bilgi almak istiyorum.';
const REGISTER_URL = `https://wa.me/905392578206?text=${encodeURIComponent(WHATSAPP_MESSAGE)}`;
const CORPORATE_MESSAGE = 'Kurumum/Üniversitem için LLM Tabanlı Uygulama Geliştirme (RAG + Fine-tuning) atölyesi hakkında bilgi almak istiyorum.';
const CORPORATE_URL = `https://wa.me/905392578206?text=${encodeURIComponent(CORPORATE_MESSAGE)}`;

const siteUrl = 'https://drmurataltun.github.io/llm-bootcamp';
const modUrl = `${siteUrl}/modul/${mod.slug}/`;

// JSON-LD: Course schema (her modül bir kurs modülü) + BreadcrumbList
const moduleJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Course',
    name: `Modül ${mod.id}: ${mod.title}`,
    description: `${mod.section} · ${mod.topics.slice(0, 5).join('; ')}`,
    url: modUrl,
    provider: {
      '@type': 'Person',
      name: 'Dr. Murat Altun',
      url: 'https://drmurataltun.github.io',
      sameAs: [
        'https://github.com/DrMuratAltun',
        'https://www.linkedin.com/in/drmurataltun',
        'https://yapayzekaokulum.com',
      ],
    },
    educationalLevel: 'Advanced',
    inLanguage: 'tr',
    courseMode: 'online',
    timeRequired: `PT${mod.hours}H`,
    teaches: mod.topics,
    about: mod.libraries.join(', '),
    isPartOf: {
      '@type': 'Course',
      name: 'LLM Tabanlı Uygulama Geliştirme Atölyesi — 42 saat · 6 modül',
      url: siteUrl,
    },
    hasCourseInstance: {
      '@type': 'CourseInstance',
      courseMode: 'online',
      inLanguage: 'tr',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Program Özeti', item: `${siteUrl}/` },
      { '@type': 'ListItem', position: 2, name: mod.section, item: `${siteUrl}/` },
      { '@type': 'ListItem', position: 3, name: `Modül ${mod.id}`, item: modUrl },
    ],
  },
];
---

<Layout
  title={`Modül ${mod.id}: ${mod.title}`}
  description={`${mod.title} · ${mod.section}. Konular: ${mod.topics.slice(0,3).join(', ')}. Dr. Murat Altun ile LLM tabanlı uygulama geliştirme atölyesi (${mod.hours} saat, ${mod.days}).`}
  activeModuleId={mod.id}
  canonical={`https://drmurataltun.github.io/llm-bootcamp/modul/${mod.slug}/`}
>

  <!-- JSON-LD: Course + BreadcrumbList schema (SEO) -->
  <script type="application/ld+json" set:html={JSON.stringify(moduleJsonLd)} />

  <!-- BREADCRUMB -->
  <div class="flex items-center gap-2 text-xs text-mid mb-4">
    <a href={base} class="hover:text-primary transition-colors">Program</a>
    <span>›</span>
    <span class={`px-2 py-0.5 rounded-full text-white text-[10px] font-bold ${badgeBg}`}>{mod.section}</span>
    <span>›</span>
    <span class="text-dark font-medium">Modül {mod.id}</span>
  </div>

  <!-- HEADER -->
  <div class="mb-6">
    <div class="flex items-start justify-between flex-wrap gap-3">
      <div>
        <div class="flex items-center gap-2 mb-2 flex-wrap">
          <span class={`inline-block text-[10px] font-bold uppercase tracking-wider text-white px-2 py-0.5 rounded ${badgeBg}`}>
            MODÜL {mod.id} · {mod.hours} SAAT
          </span>
          <span class="inline-block text-[10px] font-semibold uppercase tracking-wider text-mid px-2 py-0.5 rounded bg-warmBg border border-border">
            {mod.days} · {mod.dateRange}
          </span>
        </div>
        <h1 class="text-2xl font-bold text-dark leading-snug">{mod.title}</h1>
        <p class="text-mid text-sm mt-1">{mod.subtitle}</p>
      </div>
      <!-- Nav ok -->
      <div class="flex gap-2">
        {prevModule && (
          <a href={`${base}modul/${prevModule.slug}`} class="flex items-center gap-1 text-xs text-mid hover:text-primary border border-border rounded-lg px-3 py-2 bg-white transition-colors">
            ← Modül {prevModule.id}
          </a>
        )}
        {nextModule && (
          <a href={`${base}modul/${nextModule.slug}`} class="flex items-center gap-1 text-xs text-white bg-primary hover:bg-primary/90 rounded-lg px-3 py-2 transition-colors">
            Modül {nextModule.id} →
          </a>
        )}
      </div>
    </div>
  </div>

  <!-- SUNUM -->
  <div class="rounded-2xl overflow-hidden border border-border shadow-md mb-6 bg-dark relative">
    <div class="flex items-center gap-2 px-4 py-2 bg-dark border-b border-white/10">
      <div class="flex gap-1.5">
        <span class="w-3 h-3 rounded-full bg-red-500/70"></span>
        <span class="w-3 h-3 rounded-full bg-yellow-500/70"></span>
        <span class="w-3 h-3 rounded-full bg-green-500/70"></span>
      </div>
      <span class="text-xs text-gray-400 ml-2">📊 {mod.pptxFile}</span>
      {driveId ? (
        <span class="ml-auto text-xs text-green-400 font-semibold flex items-center gap-1">🎁 Sunum Hazır</span>
      ) : (
        <span class="ml-auto text-xs text-yellow-400 font-semibold flex items-center gap-1">🚧 Sunum Yakında</span>
      )}
    </div>
    {driveId ? (
      <iframe
        src={pptxEmbedUrl}
        width="100%"
        height="560"
        frameborder="0"
        class="w-full block bg-white"
        loading="lazy"
        title={`Modül ${mod.id} Sunumu`}
      />
    ) : (
      <div class="relative bg-gradient-to-br from-primary/80 via-secondary/70 to-accent/80" style="height: 360px;">
        <div class="absolute inset-0 flex flex-col items-center justify-center text-center p-6 text-white">
          <div class="w-16 h-16 rounded-full bg-white/10 backdrop-blur-sm flex items-center justify-center mb-4 text-4xl">🚧</div>
          <h3 class="text-xl font-bold mb-2">Sunum Henüz Yüklenmedi</h3>
          <p class="text-white/85 text-sm max-w-md mb-5">
            Modül {mod.id} sunumu Dr. Murat Altun tarafından Drive'a yüklendiğinde burada görünür olacak.
            Kayıt veya kurumsal eğitim için doğrudan WhatsApp üzerinden iletişime geçebilirsiniz.
          </p>
          <a
            href={REGISTER_URL}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 bg-[#25D366] text-white font-semibold px-6 py-3 rounded-xl hover:bg-[#1ebe57] transition-colors shadow-lg"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            WhatsApp'tan Bilgi Al
          </a>
        </div>
      </div>
    )}
  </div>

  <!-- SEKMELER: Konular / Ödevler / Notebook / Kaynaklar -->
  <div class="mb-6">
    <!-- Tab buttons -->
    <div class="flex gap-1 border-b border-border mb-4 overflow-x-auto" id="tabs">
      {[
        { key: 'konular',   label: '📋 Konular',         count: mod.topics.length },
        { key: 'odevler',   label: '📝 Ödevler',         count: mod.assignments.length },
        { key: 'notebook',  label: '💻 Notebook\'lar',   count: mod.notebooks.length },
        { key: 'kaynaklar', label: '📚 Kaynaklar',        count: mod.resources.length },
      ].map(tab => (
        <button
          data-tab={tab.key}
          onclick="switchTab(this)"
          class="tab-btn px-4 py-2 text-sm font-medium border-b-2 border-transparent text-mid hover:text-primary transition-colors -mb-px whitespace-nowrap"
        >
          {tab.label}
          <span class="ml-1 text-[10px] bg-border rounded-full px-1.5 py-0.5">{tab.count}</span>
        </button>
      ))}
    </div>

    <!-- Konular -->
    <div data-panel="konular" class="tab-panel">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
        {mod.topics.map((topic, i) => (
          <div class="flex items-start gap-3 bg-white rounded-lg border border-border p-3">
            <span class={`shrink-0 w-6 h-6 rounded-full ${badgeBg}/10 text-xs font-bold flex items-center justify-center`} style={`background-color: rgba(${mod.section === 'TEMEL' ? '109,40,217' : (mod.section === 'EKOSISTEM' || mod.section === 'RAG') ? '236,72,153' : '16,185,129'}, 0.1); color: ${mod.section === 'TEMEL' ? '#6D28D9' : (mod.section === 'EKOSISTEM' || mod.section === 'RAG') ? '#EC4899' : '#10B981'};`}>{i + 1}</span>
            <span class="text-sm text-dark leading-snug">{topic}</span>
          </div>
        ))}
      </div>
      {mod.libraries.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-2 items-center">
          <span class="text-xs text-mid font-medium">Kütüphaneler:</span>
          {mod.libraries.map(lib => (
            <code class="text-xs bg-dark text-emerald-300 rounded px-2 py-0.5 font-mono">{lib}</code>
          ))}
        </div>
      )}
    </div>

    <!-- Ödevler -->
    <div data-panel="odevler" class="tab-panel hidden">
      <div class="space-y-3">
        {mod.assignments.map((a, i) => (
          <div class="flex items-start gap-3 bg-warmBg rounded-lg border border-border p-4">
            <span class="shrink-0 w-7 h-7 rounded-full bg-secondary text-white text-xs font-bold flex items-center justify-center">{i + 1}</span>
            <p class="text-sm text-dark leading-relaxed">{a}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Notebook'lar -->
    <div data-panel="notebook" class="tab-panel hidden">
      <div class="space-y-3">
        {mod.notebooks.map((nb, i) => (
          <div class="flex items-start gap-4 bg-dark text-white rounded-xl p-4">
            <span class="shrink-0 w-8 h-8 rounded-lg bg-white/10 flex items-center justify-center text-emerald-400 font-mono text-sm font-bold">{i + 1}</span>
            <div class="flex-1">
              <code class="text-emerald-300 text-sm font-mono block mb-1">{nb.name}</code>
              <p class="text-gray-400 text-xs mb-2">{nb.desc}</p>
              {nb.url ? (
                <div class="flex flex-wrap gap-2">
                  <a href={nb.url} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-md bg-white/10 text-xs text-gray-300 hover:text-white hover:bg-white/20 transition-colors">
                    📂 Drive'da Aç
                  </a>
                  <a href={nb.url} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-md bg-yellow-500/20 text-xs text-yellow-300 hover:text-yellow-100 hover:bg-yellow-500/30 transition-colors">
                    📓 Colab'da Aç
                  </a>
                </div>
              ) : (
                <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded text-[10px] text-gray-400 bg-white/5 border border-white/10">
                  🚧 Notebook yakında yüklenecek
                </span>
              )}
            </div>
          </div>
        ))}
      </div>
      {mod.datasets.length > 0 && (
        <div class="mt-4">
          <p class="text-xs font-medium text-mid mb-2">Veri Setleri:</p>
          <div class="flex flex-wrap gap-2">
            {mod.datasets.map(ds => (
              <span class="text-xs bg-secondary/10 text-secondary border border-secondary/20 rounded-full px-3 py-1">{ds}</span>
            ))}
          </div>
        </div>
      )}
    </div>

    <!-- Kaynaklar -->
    <div data-panel="kaynaklar" class="tab-panel hidden">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        {mod.resources.map(r => (
          <a
            href={r.url}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-3 bg-white border border-border rounded-xl p-4 hover:border-primary hover:shadow-sm transition-all group"
          >
            <span class="w-8 h-8 rounded-lg bg-primary/10 flex items-center justify-center text-primary text-base">🔗</span>
            <div class="min-w-0">
              <p class="text-sm font-medium text-dark group-hover:text-primary transition-colors truncate">{r.label}</p>
              <p class="text-[10px] text-mid truncate">{r.url}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>

  <!-- CTA: Kayıt + Kurumsal -->
  <div class="mt-8 rounded-2xl bg-gradient-to-br from-primary via-secondary to-accent p-[1px]">
    <div class="bg-white rounded-2xl p-6">
      <div class="flex flex-col md:flex-row md:items-center gap-6">
        <div class="flex-1">
          <p class="text-xs font-bold uppercase tracking-widest text-secondary mb-2">BTK Akademi Atölyesi</p>
          <h2 class="font-bold text-dark mb-2">Bu atölyeye katılmak istiyorum</h2>
          <p class="text-sm text-mid leading-relaxed">
            Bireysel kayıt için BTK Akademi başvuru süreçleri, kurumsal eğitim için Dr. Murat Altun ile doğrudan iletişim.
          </p>
        </div>
        <div class="flex flex-col gap-2 shrink-0">
          <a href={REGISTER_URL} target="_blank" rel="noopener" class="inline-flex items-center justify-center gap-2 bg-[#25D366] hover:bg-[#1ebe57] text-white font-semibold px-5 py-3 rounded-xl transition-colors shadow-md">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            Bireysel Kayıt · 0539 257 82 06
          </a>
          <a href={CORPORATE_URL} target="_blank" rel="noopener" class="inline-flex items-center justify-center gap-2 bg-primary/10 text-primary text-sm px-5 py-2 rounded-xl hover:bg-primary/20 transition-colors border border-primary/20">
            🏢 Kurumsal Eğitim Talebi
          </a>
        </div>
      </div>
    </div>
  </div>

</Layout>

<script is:inline>
function switchTab(btn) {
  var key = btn.getAttribute('data-tab');
  // Update buttons
  document.querySelectorAll('.tab-btn').forEach(function(b) {
    b.classList.remove('border-primary', 'text-primary');
    b.classList.add('border-transparent', 'text-mid');
  });
  btn.classList.add('border-primary', 'text-primary');
  btn.classList.remove('border-transparent', 'text-mid');
  // Update panels
  document.querySelectorAll('.tab-panel').forEach(function(p) { p.classList.add('hidden'); });
  var panel = document.querySelector('[data-panel="' + key + '"]');
  if (panel) panel.classList.remove('hidden');
}
// Activate first tab on load
document.addEventListener('DOMContentLoaded', function() {
  var first = document.querySelector('.tab-btn');
  if (first) switchTab(first);
});
</script>
