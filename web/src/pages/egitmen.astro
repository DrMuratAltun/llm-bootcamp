---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---

<Layout
  title="Eğitmen — Dr. Murat Altun"
  description="LLM Tabanlı Uygulama Geliştirme Atölyesi eğitmeni Dr. Murat Altun hakkında. 22+ yıl eğitmenlik, BTK Akademi LLM/üretken YZ eğitmeni, MEB ders kitabı yazarı, TÜBİTAK danışmanı, RAG ve fine-tuning uzmanı."
  canonical="https://drmurataltun.github.io/llm-bootcamp/egitmen/"
>

  <!-- Breadcrumb -->
  <nav class="text-xs text-mid mb-6" aria-label="Breadcrumb">
    <a href={base} class="hover:text-primary transition-colors">Program</a>
    <span class="mx-1">›</span>
    <span class="text-dark font-medium">Eğitmen Hakkında</span>
  </nav>

  <!-- Profil Kartı -->
  <section class="bg-white rounded-2xl shadow-sm border border-border overflow-hidden mb-8">
    <!-- Kapak Barı -->
    <div class="h-28 bg-gradient-to-r from-primary via-secondary to-accent"></div>

    <div class="px-8 pb-8 -mt-14">
      <!-- Avatar + İsim -->
      <div class="flex flex-col items-center gap-4 md:flex-row md:items-end">
        <div class="w-32 h-32 rounded-2xl overflow-hidden border-4 border-white shadow-lg shrink-0 bg-warmBg">
          <img
            src={`${base}img/dr-murat-altun.png`}
            alt="Dr. Murat Altun — Yapay Zeka Eğitmeni, LLM ve Üretken YZ Uzmanı"
            loading="eager"
            class="w-full h-full object-cover"
          />
        </div>
        <div class="flex-1 text-center md:text-left md:pb-1">
          <h1 class="text-2xl font-bold text-dark" style="font-family: Georgia, serif;">Dr. Murat Altun</h1>
          <p class="text-secondary text-sm font-medium">Yapay Zekâ Uzmanı ve Eğitmeni · Bilişim Teknolojileri Öğretmeni · Yazar</p>
        </div>
      </div>

      <!-- Biyografi -->
      <p class="mt-6 text-mid leading-relaxed">
        Akdeniz Üniversitesi'nde <strong class="text-dark">Eğitsel Veri Madenciliği</strong> üzerine doktorasını tamamlamış,
        Millî Eğitim Bakanlığı bünyesinde <strong class="text-dark">22+ yıldır</strong> Bilişim Teknolojileri Öğretmeni olarak görev yapan ve
        kişisel markası <strong class="text-dark">yapayzekaokulum.com</strong> altında yapay zeka eğitmenliği yürüten akademisyen-öğretmen.
        Yapay zeka, büyük dil modelleri, makine öğrenmesi, veri madenciliği ve Python alanlarında kitap yazarı.
        <strong class="text-dark">BTK Akademi</strong> bünyesinde 2022'den bu yana Python, Veri Madenciliği, Makine Öğrenmesi, Yapay Zekâ Atölyesi,
        <strong class="text-dark">LLM Tabanlı Uygulama Geliştirme</strong> ve <strong class="text-dark">Üretken Yapay Zekâ Eğitici Eğitimi</strong> dahil
        12'den fazla eğitim programını başarıyla yürütmüştür.
      </p>

      <!-- Sosyal Linkler -->
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="https://github.com/DrMuratAltun" target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg border border-border text-xs text-mid hover:text-primary hover:border-primary/30 transition-colors">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
          GitHub
        </a>
        <a href="https://www.linkedin.com/in/drmurataltun" target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg border border-border text-xs text-mid hover:text-primary hover:border-primary/30 transition-colors">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          LinkedIn
        </a>
        <a href="https://yapayzekaokulum.com" target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg border border-border text-xs text-mid hover:text-primary hover:border-primary/30 transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/></svg>
          Yapay Zeka Okulum
        </a>
        <a href="https://www.youtube.com/@yapayzekaokulum" target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg border border-border text-xs text-mid hover:text-primary hover:border-primary/30 transition-colors">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          YouTube
        </a>
        <a href="mailto:emurataltun@gmail.com" class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg border border-border text-xs text-mid hover:text-primary hover:border-primary/30 transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          E-posta
        </a>
      </div>
    </div>
  </section>

  <!-- Detay Grid -->
  <div class="grid gap-6 md:grid-cols-2 mb-8">

    <!-- Akademik Geçmiş -->
    <section class="bg-white rounded-xl border border-border p-6">
      <h2 class="text-lg font-bold text-dark mb-4 flex items-center gap-2" style="font-family: Georgia, serif;">
        <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"/></svg>
        Akademik Geçmiş
      </h2>
      <ul class="space-y-3">
        <li class="flex items-start gap-3">
          <span class="w-2 h-2 rounded-full bg-primary mt-2 shrink-0"></span>
          <div>
            <p class="text-sm font-semibold text-dark">Doktora — Eğitsel Veri Madenciliği</p>
            <p class="text-xs text-mid">Akdeniz Üniversitesi, 2019 · Öğrenci başarısını kestiren yapay zeka modelleri</p>
          </div>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-2 h-2 rounded-full bg-secondary mt-2 shrink-0"></span>
          <div>
            <p class="text-sm font-semibold text-dark">Lisans — Bilgisayar ve Öğretim Teknolojileri Öğretmenliği</p>
            <p class="text-xs text-mid">Eskişehir Osmangazi Üniversitesi, 2004</p>
          </div>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-2 h-2 rounded-full bg-accent mt-2 shrink-0"></span>
          <div>
            <p class="text-sm font-semibold text-dark">Bilişim Teknolojileri Öğretmeni</p>
            <p class="text-xs text-mid">MEB — 22+ yıl öğretmenlik deneyimi</p>
          </div>
        </li>
      </ul>
    </section>

    <!-- Uzmanlık Alanları -->
    <section class="bg-white rounded-xl border border-border p-6">
      <h2 class="text-lg font-bold text-dark mb-4 flex items-center gap-2" style="font-family: Georgia, serif;">
        <svg class="w-5 h-5 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>
        Uzmanlık Alanları
      </h2>
      <div class="flex flex-wrap gap-2">
        {["Büyük Dil Modelleri (LLM)", "RAG (Retrieval-Augmented Generation)", "Fine-tuning (LoRA, QLoRA)", "Hugging Face", "LangChain & LangGraph", "Üretken Yapay Zekâ", "Makine Öğrenmesi", "Veri Madenciliği", "Python", "Prompt Engineering", "Ollama & LM Studio", "Bilgisayarlı Görü"].map(tag => (
          <span class="px-3 py-1.5 rounded-full text-xs font-medium bg-warmBg text-dark border border-border">
            {tag}
          </span>
        ))}
      </div>
    </section>

    <!-- BTK Akademi Sertifikaları & Eğitmenlik -->
    <section class="bg-white rounded-xl border border-border p-6">
      <h2 class="text-lg font-bold text-dark mb-4 flex items-center gap-2" style="font-family: Georgia, serif;">
        <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/></svg>
        BTK Akademi Sertifikaları & Eğitmenlik
      </h2>
      <ul class="space-y-3">
        {[
          { date: "11/2025", label: "Üretken Yapay Zekâ Araçları Eğitici Eğitimi (Eğitmen)" },
          { date: "02-03/2025", label: "Büyük Dil Modelleri (LLMs) Tabanlı Uygulama Geliştirme Atölyesi (Eğitmen)" },
          { date: "2022-2025", label: "Python, Veri Madenciliği, Makine Öğrenmesi ve YZ Atölyeleri (12+ program)" },
          { date: "2022", label: "Derin Öğrenme Uygulamaları (MEB · THK Üniversitesi)" },
          { date: "2021", label: "Yapay Zekâ Eğitimi 1-2-3 (Google · MEB)" },
          { date: "2019", label: "Veri Madenciliği Eğitimi (ODTÜ)" },
        ].map(item => (
          <li class="flex items-start gap-3">
            <span class="shrink-0 text-[10px] font-semibold uppercase tracking-wider text-accent bg-accent/10 px-2 py-0.5 rounded">{item.date}</span>
            <span class="text-sm text-mid">{item.label}</span>
          </li>
        ))}
      </ul>
    </section>

    <!-- Eğitim Kurumları -->
    <section class="bg-white rounded-xl border border-border p-6">
      <h2 class="text-lg font-bold text-dark mb-4 flex items-center gap-2" style="font-family: Georgia, serif;">
        <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
        Eğitim Verilen Kurumlar
      </h2>
      <div class="flex flex-wrap gap-2">
        {["BTK Akademi", "MEB", "DeneYap Atölyeleri", "Tech İstanbul", "Akdeniz Üniversitesi", "Antalya İl MEM", "TÜBİTAK", "Üniversiteler", "Teknoparklar"].map(org => (
          <span class="px-3 py-1.5 rounded-lg text-xs font-medium bg-primary/5 text-primary border border-primary/10">
            {org}
          </span>
        ))}
      </div>
    </section>

  </div>

  <!-- Kurumsal Eğitim CTA -->
  <section class="rounded-2xl bg-gradient-to-r from-dark via-primary to-secondary text-white p-8 mb-8 shadow-xl">
    <div class="flex flex-col md:flex-row md:items-center gap-6">
      <div class="flex-1">
        <p class="text-xs font-bold uppercase tracking-widest text-secondary mb-2">Kurumsal & Özel Eğitim</p>
        <h2 class="text-2xl font-bold mb-2" style="font-family: Georgia, serif;">Şirketinize, üniversitenize özel LLM atölyesi</h2>
        <p class="text-sm text-gray-200 leading-relaxed">
          LLM tabanlı uygulama geliştirme, RAG mimarisi, fine-tuning ve üretken yapay zeka konularında
          <strong>özel içerik, canlı atölye ve in-house bootcamp</strong> talepleriniz için
          doğrudan iletişime geçin.
        </p>
      </div>
      <div class="flex flex-col gap-3 shrink-0">
        <a href="https://wa.me/905077501982?text=Kurumsal%20LLM%20Tabanl%C4%B1%20Uygulama%20Geli%C5%9Ftirme%20At%C3%B6lyesi%20hakk%C4%B1nda%20bilgi%20almak%20istiyorum." target="_blank" rel="noopener" class="inline-flex items-center justify-center gap-2 bg-[#25D366] hover:bg-[#1ebe57] text-white font-semibold px-5 py-3 rounded-xl transition-colors shadow-lg">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
          WhatsApp · 0507 750 19 82
        </a>
        <a href="tel:+905077501982" class="inline-flex items-center justify-center gap-2 bg-white/10 hover:bg-white/20 text-white text-sm px-5 py-2 rounded-xl transition-colors border border-white/20">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          Ara — 0507 750 19 82
        </a>
      </div>
    </div>
  </section>

  <!-- Diğer Platformlar -->
  <section class="bg-white rounded-xl border border-border p-6 mb-8">
    <h2 class="text-lg font-bold text-dark mb-4 flex items-center gap-2" style="font-family: Georgia, serif;">
      <svg class="w-5 h-5 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
      Dr. Murat Altun — Diğer Bootcamp'ler
    </h2>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <a href="https://drmurataltun.github.io/computer-vision-bootcamp/" target="_blank" rel="noopener" class="group flex items-center gap-3 p-4 rounded-lg border border-border hover:border-secondary/30 hover:bg-warmBg transition-all">
        <div class="w-10 h-10 rounded-lg bg-secondary/10 flex items-center justify-center shrink-0">
          <span class="text-lg">📷</span>
        </div>
        <div>
          <p class="text-sm font-semibold text-dark group-hover:text-secondary transition-colors">Bilgisayarlı Görü Bootcamp</p>
          <p class="text-xs text-mid">OpenCV + PyTorch (90 saat)</p>
        </div>
      </a>
      <a href="https://drmurataltun.github.io/deep-learning-bootcamp/" target="_blank" rel="noopener" class="group flex items-center gap-3 p-4 rounded-lg border border-border hover:border-primary/30 hover:bg-warmBg transition-all">
        <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center shrink-0">
          <span class="text-lg">🧠</span>
        </div>
        <div>
          <p class="text-sm font-semibold text-dark group-hover:text-primary transition-colors">Derin Öğrenme Bootcamp</p>
          <p class="text-xs text-mid">Keras 3 ile 90 saat</p>
        </div>
      </a>
      <a href="https://drmurataltun.github.io/VB-YZ-90/" target="_blank" rel="noopener" class="group flex items-center gap-3 p-4 rounded-lg border border-border hover:border-accent/30 hover:bg-warmBg transition-all">
        <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center shrink-0">
          <span class="text-lg">📊</span>
        </div>
        <div>
          <p class="text-sm font-semibold text-dark group-hover:text-accent transition-colors">VB-YZ-90</p>
          <p class="text-xs text-mid">Veri Bilimi ve YZ Uzmanlığı (90 saat)</p>
        </div>
      </a>
      <a href="https://yapayzekaokulum.com" target="_blank" rel="noopener" class="group flex items-center gap-3 p-4 rounded-lg border border-border hover:border-secondary/30 hover:bg-warmBg transition-all">
        <div class="w-10 h-10 rounded-lg bg-secondary/10 flex items-center justify-center shrink-0">
          <span class="text-lg">🎓</span>
        </div>
        <div>
          <p class="text-sm font-semibold text-dark group-hover:text-secondary transition-colors">Yapay Zeka Okulum</p>
          <p class="text-xs text-mid">Eğitimciler için YZ eğitim platformu</p>
        </div>
      </a>
      <a href="https://gencyz.com" target="_blank" rel="noopener" class="group flex items-center gap-3 p-4 rounded-lg border border-border hover:border-accent/30 hover:bg-warmBg transition-all">
        <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center shrink-0">
          <span class="text-lg">🧒</span>
        </div>
        <div>
          <p class="text-sm font-semibold text-dark group-hover:text-accent transition-colors">GençYZ</p>
          <p class="text-xs text-mid">Çocuklar için yapay zeka eğitimi</p>
        </div>
      </a>
      <a href="https://akademikyz.com" target="_blank" rel="noopener" class="group flex items-center gap-3 p-4 rounded-lg border border-border hover:border-primary/30 hover:bg-warmBg transition-all">
        <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center shrink-0">
          <span class="text-lg">📚</span>
        </div>
